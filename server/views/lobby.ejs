<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Summer Camp - Lobby</title>
    <link rel="stylesheet" href="/css/lobby.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <div class="lobby-card">
            <div class="header-section">
                <a href="/logout" class="logout-btn">
                    <i class="fas fa-sign-out-alt"></i>
                    Logout
                </a>
            </div>
            
            <div class="user-section">
                <div class="user-icon">
                    <i class="fas fa-user-circle"></i>
                </div>
                <h1 class="user-name">Welcome, <%= user.name %>!</h1>
                <div class="score-section">
                    <div class="score-display">
                        <span class="score-text">Current Score: <%= user.score || 0 %> points</span>
                    </div>
                </div>
            </div>
            
            <div class="ai-description">
                <h2 class="description-title">How Python Works</h2>
                <p class="description-text">
                    Python is a high-level programming language designed for readability and simplicity. 
                    It uses straightforward syntax to let programmers write clear and concise code. 
                    Python runs instructions line by line and supports many libraries that make complex tasks easier to implement.
                </p>
            </div>
            
            <div class="action-section">
                <button class="start-btn">
                    <span>Start Recap</span>
                    <div class="btn-icon">
                        <i class="fas fa-play"></i>
                    </div>
                </button>
            </div>
        </div>
    </div>

    <script>
        window.nextTask = <%= nextTask %>;
    </script>
    <script src="/js/lobby.js"></script>
</body>
</html>
