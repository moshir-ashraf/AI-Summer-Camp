<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Summer Camp - Admin Dashboard</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="admin-layout">
        <!-- Side Navigation -->
        <div class="sidebar">
            <div class="sidebar-header">
                <div class="admin-icon">
                    <i class="fas fa-crown"></i>
                </div>
                <h2 class="sidebar-title">Admin Panel</h2>
                <p class="admin-name"><%= user.name %></p>
            </div>
            
            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <li class="nav-item active" data-panel="leaderboard">
                        <i class="fas fa-trophy"></i>
                        <span>Leaderboard</span>
                    </li>
                    <li class="nav-item" data-panel="task-mode">
                        <i class="fas fa-cogs"></i>
                        <span>Task Mode</span>
                    </li>
                    <% if (currentMode === 'Python Recap') { %>
                        <li class="nav-item" data-panel="task1">
                            <i class="fas fa-code"></i>
                            <span>Python Programming Recap</span>
                        </li>
                    <% } else if (currentMode === 'Model Mimic') { %>
                        <li class="nav-item" data-panel="task1">
                            <i class="fas fa-brain"></i>
                            <span>Deep Learning Tasks</span>
                        </li>
                    <% } else { %>
                        <li class="nav-item" data-panel="task1">
                            <i class="fas fa-seedling"></i>
                            <span>Select Task Mode First</span>
                        </li>
                    <% } %>
                </ul>
            </nav>
            
            <div class="sidebar-footer">
                <button class="danger-btn">
                    <i class="fas fa-stop-circle"></i>
                    <span>End Game</span>
                </button>
                <button class="logout-btn">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </button>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Leaderboard Panel -->
            <div id="leaderboard-panel" class="content-panel active">
                <div class="panel-header">
                    <h1 class="panel-title">
                        <i class="fas fa-trophy"></i>
                        Student Leaderboard
                    </h1>
                    <p class="panel-subtitle">Real-time ranking of all participants</p>
                </div>
                
                <div class="leaderboard-container">
                    <% if (students && students.length > 0) { %>
                        <!-- Top 3 Students -->
                        <div class="podium-container">
                            <% for (let i = 0; i < Math.min(3, students.length); i++) { %>
                                <div class="podium-place place-<%= i + 1 %>">
                                    <div class="podium-icon">
                                        <% if (i === 0) { %>
                                            <i class="fas fa-crown"></i>
                                        <% } else if (i === 1) { %>
                                            <i class="fas fa-medal"></i>
                                        <% } else { %>
                                            <i class="fas fa-award"></i>
                                        <% } %>
                                    </div>
                                    <div class="podium-info">
                                        <h3 class="student-name"><%= students[i].name %></h3>
                                        <p class="student-score"><%= students[i].score || 0 %> pts</p>
                                        <% if (currentMode === 'Model Mimic') { %>
                                            <p class="student-progress">Task <%= (students[i].lastTaskCompleted || 0) %>/5</p>
                                        <% } else { %>
                                            <p class="student-progress">Task <%= (students[i].lastTaskCompleted || 0) %>/1</p>
                                        <% } %>
                                    </div>
                                    <div class="podium-rank">#<%= i + 1 %></div>
                                </div>
                            <% } %>
                        </div>
                        
                        <!-- Remaining Students -->
                        <% if (students.length > 3) { %>
                            <div class="students-list">
                                <h3 class="list-title">Other Participants</h3>
                                <% for (let i = 3; i < students.length; i++) { %>
                                    <div class="student-row">
                                        <div class="student-rank">#<%= i + 1 %></div>
                                        <div class="student-details">
                                            <h4 class="student-name"><%= students[i].name %></h4>
                                            <% if (currentMode === 'Model Mimic') { %>
                                                <p class="student-meta">Task <%= (students[i].lastTaskCompleted || 0) %>/5</p>
                                            <% } else { %>
                                                <p class="student-meta">Task <%= (students[i].lastTaskCompleted || 0) %>/1</p>
                                            <% } %>
                                        </div>
                                        <div class="student-score"><%= students[i].score || 0 %> pts</div>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-users-slash"></i>
                            <h3>No Students Yet</h3>
                            <p>Students will appear here once they register and start playing.</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Task Mode Panel -->
            <div id="task-mode-panel" class="content-panel">
                <div class="panel-header">
                    <h1 class="panel-title">
                        <i class="fas fa-cogs"></i>
                        Task Mode Configuration
                    </h1>
                    <p class="panel-subtitle">Choose the current learning mode for students</p>
                </div>

                <div class="mode-selection-container">
                    <div class="current-mode-display">
                        <h3>Current Mode</h3>
                        <div class="current-mode-card">
                            <i class="fas fa-info-circle"></i>
                            <span id="current-mode-text">
                                <% if (currentMode) { %>
                                    <%= currentMode %>
                                <% } else { %>
                                    No mode selected
                                <% } %>
                            </span>
                        </div>
                    </div>

                    <div class="mode-options">
                        <h3>Select Mode</h3>
                        <div class="mode-cards">
                            <div class="mode-card" data-mode="Python Recap">
                                <div class="mode-icon">
                                    <i class="fas fa-bolt"></i>
                                </div>
                                <h4>Python Recap</h4>
                                <p>Real-time collaborative quiz with 20 questions. All students participate simultaneously with instructor-controlled timing.</p>
                                <button class="mode-select-btn" data-mode="Python Recap">
                                    <i class="fas fa-play"></i>
                                    Select Mode
                                </button>
                            </div>

                            <div class="mode-card" data-mode="Model Mimic">
                                <div class="mode-icon">
                                    <i class="fas fa-layer-group"></i>
                                </div>
                                <h4>Model Mimic</h4>
                                <p>Sequential tasks (1-5) where students progress at their own pace through different AI and ML challenges.</p>
                                <button class="mode-select-btn" data-mode="Model Mimic">
                                    <i class="fas fa-play"></i>
                                    Select Mode
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Task Panels -->
            <div id="task1-panel" class="content-panel">
                <div class="panel-header">
                    <h1 class="panel-title">
                        <% if (currentMode === 'Python Recap') { %>
                            <i class="fas fa-code"></i>
                            Python Programming Recap
                        <% } else if (currentMode === 'Model Mimic') { %>
                            <i class="fas fa-brain"></i>
                            Deep Learning Tasks
                        <% } else { %>
                            <i class="fas fa-cogs"></i>
                            Game Controls - Select Task Mode First
                        <% } %>
                    </h1>
                    <div class="task-actions">
                        <% if (currentMode === 'Python Recap') { %>
                            <a href="/task1-realtime" class="task-btn" target="_blank">
                                <i class="fas fa-eye"></i>
                                Preview Live Quiz
                            </a>
                        <% } else if (currentMode === 'Model Mimic') { %>
                            <a href="/task1" class="task-btn" target="_blank">
                                <i class="fas fa-eye"></i>
                                Preview Task 1
                            </a>
                            <a href="/task2" class="task-btn" target="_blank">
                                <i class="fas fa-eye"></i>
                                Preview Task 2
                            </a>
                            <a href="/task3" class="task-btn" target="_blank">
                                <i class="fas fa-eye"></i>
                                Preview Task 3
                            </a>
                            <a href="/task4" class="task-btn" target="_blank">
                                <i class="fas fa-eye"></i>
                                Preview Task 4
                            </a>
                            <a href="/task5" class="task-btn" target="_blank">
                                <i class="fas fa-eye"></i>
                                Preview Task 5
                            </a>
                        <% } %>
                    </div>
                </div>

                <!-- Game Control Section -->
                <div class="game-control-section">
                    <div class="game-status">
                        <h3 class="game-status-title">
                            <% if (currentMode === 'Python Recap') { %>
                                Quiz Status
                            <% } else if (currentMode === 'Model Mimic') { %>
                                Task Progress Status
                            <% } else { %>
                                Game Status
                            <% } %>
                        </h3>
                        <div class="game-info">
                            <div class="game-info-item">
                                <% if (currentMode === 'Python Recap') { %>
                                    <span class="info-label">Current Question:</span>
                                    <span class="info-value" id="current-question">1</span>
                                    <span class="info-total">/ 20</span>
                                <% } else if (currentMode === 'Model Mimic') { %>
                                    <span class="info-label">Current Task Phase:</span>
                                    <span class="info-value" id="current-question">1</span>
                                    <span class="info-total">/ 5</span>
                                <% } else { %>
                                    <span class="info-label">Current Item:</span>
                                    <span class="info-value" id="current-question">1</span>
                                    <span class="info-total">/ ?</span>
                                <% } %>
                            </div>
                            <div class="game-info-item">
                                <span class="info-label">Status:</span>
                                <span class="info-value game-status-indicator" id="game-status">Waiting</span>
                            </div>
                            <div class="game-info-item">
                                <% if (currentMode === 'Python Recap') { %>
                                    <span class="info-label">Students Answered:</span>
                                    <span class="info-value" id="students-answered">0</span>
                                    <span class="info-total" id="total-students">/ 0</span>
                                <% } else if (currentMode === 'Model Mimic') { %>
                                    <span class="info-label">Students Active:</span>
                                    <span class="info-value" id="students-answered">0</span>
                                    <span class="info-total" id="total-students">/ 0</span>
                                <% } else { %>
                                    <span class="info-label">Students Participated:</span>
                                    <span class="info-value" id="students-answered">0</span>
                                    <span class="info-total" id="total-students">/ 0</span>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="game-controls">
                        <button id="start-game-btn" class="control-btn primary">
                            <i class="fas fa-play"></i>
                            <% if (currentMode === 'Python Recap') { %>
                                Start Quiz
                            <% } else if (currentMode === 'Model Mimic') { %>
                                Enable Tasks
                            <% } else { %>
                                Start Game
                            <% } %>
                        </button>
                        <button id="pause-game-btn" class="control-btn secondary" style="display: none;">
                            <i class="fas fa-pause"></i>
                            <% if (currentMode === 'Python Recap') { %>
                                Pause Quiz
                            <% } else { %>
                                Pause Game
                            <% } %>
                        </button>
                        <button id="resume-game-btn" class="control-btn primary" style="display: none;">
                            <i class="fas fa-play"></i>
                            <% if (currentMode === 'Python Recap') { %>
                                Resume Quiz
                            <% } else { %>
                                Resume Game
                            <% } %>
                        </button>
                        <button id="reset-game-btn" class="control-btn danger">
                            <i class="fas fa-refresh"></i>
                            Reset Game
                        </button>
                        <% if (currentMode === 'Python Recap') { %>
                            <button id="next-question-btn" class="control-btn primary" style="display: none;">
                                <i class="fas fa-forward"></i>
                                Next Question
                            </button>
                            <button id="end-question-btn" class="control-btn warning" style="display: none;">
                                <i class="fas fa-stop"></i>
                                End Question Early
                            </button>
                        <% } else if (currentMode === 'Model Mimic') { %>
                            <button id="next-task-btn" class="control-btn primary" style="display: none;">
                                <i class="fas fa-forward"></i>
                                Next Task
                            </button>
                        <% } %>
                    </div>

                    <!-- Question Timer (only for Python Recap) -->
                    <% if (currentMode === 'Python Recap') { %>
                        <div class="question-timer" id="question-timer" style="display: none;">
                            <div class="timer-header">
                                <h4>Question Timer</h4>
                                <span class="timer-display" id="timer-display">15</span>
                            </div>
                            <div class="timer-bar">
                                <div class="timer-progress" id="timer-progress"></div>
                            </div>
                        </div>
                    <% } else if (currentMode === 'Model Mimic') { %>
                        <div class="task-info-panel">
                            <h4>Task Management</h4>
                            <p>Students work at their own pace through tasks 1-5. No timer needed - they progress individually when ready.</p>
                            <div class="task-status">
                                <span class="info-note">Use "Enable Tasks" to allow students to begin, "Pause Game" to temporarily prevent new starts.</span>
                            </div>
                        </div>
                    <% } %>
                </div>
                
                <div class="task-stats">
                    <% if (students && students.length > 0) { %>
                        <% 
                            const maxTasks = currentMode === 'Model Mimic' ? 5 : 1;
                            const taskStats = students.reduce((acc, student) => {
                                const completed = (student.lastTaskCompleted || 0) >= maxTasks;
                                if (completed) acc.completed++;
                                else acc.inProgress++;
                                return acc;
                            }, {completed: 0, inProgress: 0});
                        %>
                        
                        <div class="stat-card">
                            <div class="stat-icon completed">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="stat-info">
                                <h3><%= taskStats.completed %></h3>
                                <p>Completed</p>
                            </div>
                        </div>
                        
                        <div class="stat-card">
                            <div class="stat-icon pending">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="stat-info">
                                <h3><%= taskStats.inProgress %></h3>
                                <p>Not Started</p>
                            </div>
                        </div>
                        
                        <div class="stat-card">
                            <div class="stat-icon total">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="stat-info">
                                <h3><%= students.length %></h3>
                                <p>Total Students</p>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-chart-bar"></i>
                            <h3>No Data Available</h3>
                            <p>Task statistics will appear once students start participating.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Pass current mode to JavaScript
        window.currentMode = "<%= currentMode || '' %>";
    </script>
    <script src="/js/admin.js"></script>
</body>
</html>
